@{
    ViewData["Title"] = "Inscription réussie";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                <div class="mb-4">
                    <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                </div>
                <h2 class="card-title text-success">Inscription réussie !</h2>
                <p class="card-text">
                    Merci de vous être inscrit à la Ligue Dimanche.
                    Un email de vérification a été envoyé à votre adresse email.
                </p>
                <p class="card-text">
                    <strong>Veuillez vérifier votre boîte email et cliquer sur le lien de vérification pour activer votre compte.</strong>
                </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Retour à l'accueil</a>
                </div>
            </div>
        </div>
    </div>
</div>