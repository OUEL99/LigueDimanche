@{
    ViewData["Title"] = "Vérification d'email";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
                {
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="card-title text-success">Email vérifié !</h2>
                    <p class="card-text text-success">
                        @ViewBag.SuccessMessage
                    </p>
                    <div class="mt-4">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Se connecter</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Accueil</a>
                    </div>
                }
                else if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="mb-4">
                        <i class="fas fa-times-circle text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="card-title text-danger">Erreur de vérification</h2>
                    <p class="card-text text-danger">
                        @ViewBag.ErrorMessage
                    </p>
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Retour à l'accueil</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>